# Database — DATABASE_URL is constructed from these in docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=constellation

# Server
PORT=3000
NODE_ENV=production

# Public URL of the relay — your Cloudflare tunnel URL.
# Found in the Cloudflare Zero Trust dashboard under Networks → Tunnels → your tunnel → Public Hostnames.
RELAY_URL=https://relay.your-domain.com

# Cloudflare Tunnel token — from the Cloudflare Zero Trust dashboard.
# Networks → Tunnels → your tunnel → Install connector → copy the --token value.
CLOUDFLARE_TUNNEL_TOKEN=

# Proxy trust preset — do not change this for the tunnel setup.
TRUST_PROXY_PRESET=cloudflare-tunnel

# Authorization server: asterism (https://github.com/Mahasamuha/asterism-proxy). Its
# issuer URL, exactly as asterism publishes it: a bare https origin on its own hostname.
# The relay verifies asterism-issued access tokens with audience ${RELAY_URL}/mcp.
# Register the relay in asterism as a resource server; admin is the "admin" scope,
# which asterism grants only to the constellation-admins group of your identity provider.
# With the bundled asterism (below) this is also asterism's ISSUER_URL.
ASTERISM_ISSUER=https://auth.example.com

# Run the bundled asterism from this compose file: uncomment, then copy
# asterism.env.example to asterism.env and fill it in. Leave commented to use an
# asterism you run elsewhere.
# COMPOSE_PROFILES=asterism

# Group an account must be in, besides holding the "admin" scope, to use admin endpoints
# and register a hub. Also restrict the scope in asterism: see docs/configuration.md.
# ADMIN_GROUP=constellation-admins

# Timeouts and rate limits
RPC_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_MAX_MISSED=3
RATE_LIMIT_TOOL_CALLS_PER_MIN=60
RATE_LIMIT_EXPENSIVE_TOOLS_PER_MIN=20
RATE_LIMIT_STATIC_PER_15MIN=300
RATE_LIMIT_WS_RECONNECT_PER_MIN=10
