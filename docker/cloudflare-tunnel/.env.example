# Database — DATABASE_URL is constructed from these in docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=constellation

# Server
PORT=3000
NODE_ENV=production

# Public URL of the broker — your Cloudflare tunnel URL.
# Found in the Cloudflare Zero Trust dashboard under Networks → Tunnels → your tunnel → Public Hostnames.
BROKER_URL=https://broker.your-domain.com

# Cloudflare Tunnel token — from the Cloudflare Zero Trust dashboard.
# Networks → Tunnels → your tunnel → Install connector → copy the --token value.
CLOUDFLARE_TUNNEL_TOKEN=

# Proxy trust preset — do not change this for the tunnel setup.
TRUST_PROXY_PRESET=cloudflare-tunnel

# Auth mode: local (built-in username/password) or oidc (external provider)
AUTH_MODE=local

# OIDC provider (required only when AUTH_MODE=oidc)
#OIDC_ISSUER=https://accounts.google.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=

# Token lifetimes
OAUTH_ACCESS_TOKEN_TTL_HOURS=24
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
OAUTH_DYNAMIC_CLIENT_TTL_HOURS=24

# Timeouts and rate limits
RPC_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_MAX_MISSED=3
RATE_LIMIT_TOOL_CALLS_PER_MIN=60
RATE_LIMIT_EXPENSIVE_TOOLS_PER_MIN=20
RATE_LIMIT_OAUTH_PER_15MIN=10
RATE_LIMIT_WS_RECONNECT_PER_MIN=10
