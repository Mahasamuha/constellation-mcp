# Settings for the optional bundled asterism authorization server (the "asterism"
# compose profile). Copy to asterism.env. Only asterism-proxy and asterism-postgres
# read this file; the relay reads .env. ISSUER_URL is not set here: compose passes
# ASTERISM_ISSUER from .env, so the relay and asterism always agree on it.
# Full reference: https://github.com/Mahasamuha/asterism-proxy/blob/main/.env.example
# and docs/deployment.md in that repo.

# Database (asterism-postgres). Change the password, and keep DATABASE_URL in step.
POSTGRES_USER=asterism
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=asterism
DATABASE_URL=postgresql://asterism:replace-with-a-strong-password@asterism-postgres:5432/asterism

LOG_LEVEL=info

# Signs asterism's session and CSRF cookies. Required, at least 32 characters.
# Generate one with: openssl rand -hex 32
COOKIE_SECRET=

# Reverse-proxy hops in front of asterism (1 for the host reverse proxy or the
# Cloudflare tunnel). Never "true".
TRUST_PROXY=1

# Upstream identity provider (e.g. Authentik). Constellation admins, hub identity and
# group-based share access all need it: groups and constellation_username come only
# from here. Local accounts carry no groups and no claims.
# The provider must allow the refresh_token grant and the offline_access scope.
ENABLE_OIDC=true
OIDC_ISSUER=https://authentik.example.com/application/o/asterism/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: released=upstream pairs when the provider names a claim differently,
# e.g. groups=roles. Never map groups or constellation_username onto a claim users
# can edit (preferred_username, name, nickname, email, ...).
# OIDC_CLAIM_MAP=
# Optional: groups whose members may use asterism's own /admin pages.
# ADMIN_GROUPS=asterism-admins

# Built-in accounts, for people without an identity provider. Such users can use
# nodes and MCP clients, but can never be a Constellation admin (so cannot register
# a hub). With local accounts on, set SETUP_TOKEN before exposing asterism, then open
# /setup once to create the first account.
ENABLE_LOCAL_ACCOUNTS=false
# SETUP_TOKEN=

# Optional bearer token (at least 32 characters) for GET /metrics; unset = 404.
# METRICS_TOKEN=
