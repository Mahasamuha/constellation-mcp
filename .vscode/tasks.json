{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "node: build (watch)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/packages/node" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "tsup",
        "pattern": { "regexp": "^(ERROR.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^CLI Building entry",
          "endsPattern": "^CLI Build success"
        }
      },
      "group": "build"
    },
    {
      "label": "cli: build (watch)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/packages/cli" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "tsup",
        "pattern": { "regexp": "^(ERROR.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^CLI Building entry",
          "endsPattern": "^CLI Build success"
        }
      },
      "group": "build"
    }
  ]
}
