# Local development environment.
# For Docker deployments, use the .env.example in docker/standard/ or docker/cloudflare-tunnel/.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=constellation
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5432/constellation

# Server
PORT=3000
NODE_ENV=development

# Auth mode: local (built-in username/password) or oidc (external provider)
AUTH_MODE=local

# Proxy trust
TRUST_PROXY=127.0.0.1

# OIDC upstream provider (required only when AUTH_MODE=oidc)
#OIDC_ISSUER=https://accounts.google.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=

# Relay public URL
RELAY_URL=http://localhost:3000

# Token lifetimes
OAUTH_ACCESS_TOKEN_TTL_HOURS=24
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
OAUTH_DYNAMIC_CLIENT_TTL_HOURS=24

OAUTH_ALLOWED_REDIRECT_ORIGINS=https://claude.ai,https://chatgpt.com,https://cursor.com

# Timeouts and rate limits
RPC_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_MAX_MISSED=3
RATE_LIMIT_TOOL_CALLS_PER_MIN=60
RATE_LIMIT_EXPENSIVE_TOOLS_PER_MIN=20
RATE_LIMIT_OAUTH_PER_15MIN=10
RATE_LIMIT_WS_RECONNECT_PER_MIN=10
