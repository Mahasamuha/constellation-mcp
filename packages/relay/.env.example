# Local development environment.
# For Docker deployments, use the .env.example in docker/standard/ or docker/cloudflare-tunnel/.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=constellation
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5432/constellation

# Server
PORT=3000
NODE_ENV=development

# Authorization server: asterism. Its issuer URL, exactly as asterism publishes it.
# Must be https (http only on a loopback host, for development). The relay verifies
# asterism-issued access tokens with audience ${RELAY_URL}/mcp. Register the relay in
# asterism as a resource server; admin is the "admin" scope, which asterism grants only
# to the constellation-admins group.
ASTERISM_ISSUER=http://localhost:4000

# Group an account must be in, besides holding the "admin" scope, to use admin endpoints
# and register a hub. Also restrict the scope in asterism: see docs/configuration.md.
# ADMIN_GROUP=constellation-admins

# Proxy trust
TRUST_PROXY=127.0.0.1

# Relay public URL
RELAY_URL=http://localhost:3000

# Timeouts and rate limits
RPC_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_MAX_MISSED=3
RATE_LIMIT_TOOL_CALLS_PER_MIN=60
RATE_LIMIT_EXPENSIVE_TOOLS_PER_MIN=20
RATE_LIMIT_STATIC_PER_15MIN=300
RATE_LIMIT_WS_RECONNECT_PER_MIN=10
