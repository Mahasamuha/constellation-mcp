generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BrokerRole {
  USER
  ADMIN
}

model User {
  id              String      @id @default(cuid())
  oidcSub         String?     @map("oidc_sub")
  oidcIssuer      String?     @map("oidc_issuer")
  email           String
  role            BrokerRole  @default(USER)
  createdAt       DateTime    @default(now()) @map("created_at")
  deactivatedAt   DateTime?   @map("deactivated_at")
  lastKnownClaims Json?       @map("last_known_claims")

  executors       Executor[]
  executorTokens  ExecutorToken[]
  pathLabels      PathLabel[]
  brokerFilters   BrokerPathFilter[]
  oauthSessions   OauthSession[]
  localUser       LocalUser?
  activityLogs    ActivityLog[]

  @@unique([oidcSub, oidcIssuer])
  @@map("users")
}

model LocalUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")
  isActive     Boolean   @default(true) @map("is_active")
  userId       String    @unique @map("user_id")

  user User @relation(fields: [userId], references: [id])

  @@map("local_users")
}

enum ExecutorTokenType {
  NODE
  HUB
}

model ExecutorToken {
  id                String            @id @default(cuid())
  userId            String?           @map("user_id")
  tokenType         ExecutorTokenType @default(NODE) @map("token_type")
  tokenHash         String            @unique @map("token_hash")
  approvedByUserId  String?           @map("approved_by_user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  lastUsedAt        DateTime?         @map("last_used_at")
  revokedAt         DateTime?         @map("revoked_at")
  expiresAt         DateTime?         @map("expires_at")

  user      User?      @relation(fields: [userId], references: [id])
  executors Executor[]

  @@map("executor_tokens")
}

enum DisconnectReason {
  clean
  timeout
  error
}

model Executor {
  id                   String            @id @default(cuid())
  userId               String?           @map("user_id")
  executorTokenId      String            @map("executor_token_id")
  host                 String
  registeredAt         DateTime          @default(now()) @map("registered_at")
  lastHeartbeatAt      DateTime?         @map("last_heartbeat_at")
  lastDisconnectReason DisconnectReason? @map("last_disconnect_reason")

  user             User?              @relation(fields: [userId], references: [id])
  executorToken    ExecutorToken      @relation(fields: [executorTokenId], references: [id])
  pathLabels       PathLabel[]
  brokerFilters    BrokerPathFilter[]
  sharedPathLabels SharedPathLabel[]

  // Partial unique indexes defined in raw migration SQL (Prisma does not support WHERE on @@unique):
  //   executors_user_id_host_key:           UNIQUE (user_id, host) WHERE user_id IS NOT NULL
  //   executors_executor_token_id_host_key: UNIQUE (executor_token_id, host)
  @@map("executors")
}

model PathLabel {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  executorId   String   @map("executor_id")
  label        String
  reportedPath String   @map("reported_path")
  instructions String?  @map("instructions")

  user     User     @relation(fields: [userId], references: [id])
  executor Executor @relation(fields: [executorId], references: [id])

  @@unique([userId, label])
  @@map("path_labels")
}

enum PatternType {
  glob
  regex
}

model BrokerPathFilter {
  id              String      @id @default(cuid())
  scopeUserId     String      @map("scope_user_id")
  scopeExecutorId String?     @map("scope_executor_id")
  pattern         String
  patternType     PatternType @map("pattern_type")
  createdAt       DateTime    @default(now()) @map("created_at")

  scopeUser     User      @relation(fields: [scopeUserId], references: [id])
  scopeExecutor Executor? @relation(fields: [scopeExecutorId], references: [id])

  @@map("broker_path_filters")
}

enum ActivityEventType {
  tool_call
  tool_error
  rate_limited
  executor_connect
  executor_disconnect
}

model ActivityLog {
  id           Int               @id @default(autoincrement())
  // Null for events with no associated user — e.g. connect/disconnect for
  // executors that aren't bound to any single user (hub installations).
  // Readable only by admins via GET /api/admin/activity.
  userId       String?           @map("user_id")
  eventType    ActivityEventType @map("event_type")
  host         String?
  tool         String?
  label        String?
  requestId    String?           @map("request_id")
  durationMs   Int?              @map("duration_ms")
  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  createdAt    DateTime          @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model LoginFailure {
  id       Int      @id @default(autoincrement())
  ip       String
  failedAt DateTime @default(now()) @map("failed_at")

  @@index([ip, failedAt])
  @@map("login_failures")
}

model AuthCode {
  codeHash            String   @id @map("code_hash")
  userId              String   @map("user_id")
  clientId            String   @map("client_id")
  redirectUri         String   @map("redirect_uri")
  codeChallenge       String?  @map("code_challenge")
  codeChallengeMethod String?  @map("code_challenge_method")
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("auth_codes")
}

model DeviceCode {
  deviceCode       String   @id @map("device_code")
  userCode         String   @unique @map("user_code")
  scope            String
  expiresAt        DateTime @map("expires_at")
  status           String   @default("pending")
  userId           String?  @map("user_id")
  hostName         String?  @map("host_name")
  pendingUserId    String?  @map("pending_user_id")
  elevateSessionId String?  @map("elevate_session_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("device_codes")
}

model OauthClient {
  id               String   @id @default(cuid())
  clientSecretHash String?  @map("client_secret_hash")
  redirectUris     String[] @map("redirect_uris")
  grantTypes       String[] @map("grant_types")
  isDynamic        Boolean  @map("is_dynamic")
  createdAt        DateTime @default(now()) @map("created_at")

  oauthSessions OauthSession[]

  @@map("oauth_clients")
}

model OauthSession {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  mcpClientId           String    @map("mcp_client_id")
  accessTokenHash       String    @unique @map("access_token_hash")
  issuedAt              DateTime  @default(now()) @map("issued_at")
  expiresAt             DateTime  @map("expires_at")
  refreshTokenHash      String?   @unique @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  adminUntil            DateTime? @map("admin_until")

  user      User        @relation(fields: [userId], references: [id])
  mcpClient OauthClient @relation(fields: [mcpClientId], references: [id])

  @@map("oauth_sessions")
}

model SharedPathLabel {
  id             String   @id @default(cuid())
  executorId     String   @map("executor_id")
  label          String
  reportedPath   String   @map("reported_path")
  permissionBlob Json     @map("permission_blob")
  instructions   String?  @map("instructions")
  updatedAt      DateTime @updatedAt @map("updated_at")

  executor Executor @relation(fields: [executorId], references: [id])

  @@unique([executorId, label])
  @@map("shared_path_labels")
}
