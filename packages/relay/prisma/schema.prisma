generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  executors      Executor[]
  executorTokens ExecutorToken[]
  pathShares     PathShare[]
  relayFilters   RelayPathFilter[]
  activityLogs   ActivityLog[]

  @@map("users")
}

enum ExecutorTokenType {
  NODE
  HUB
}

model ExecutorToken {
  id               String            @id @default(cuid())
  userId           String?           @map("user_id")
  tokenType        ExecutorTokenType @default(NODE) @map("token_type")
  tokenHash        String            @unique @map("token_hash")
  approvedByUserId String?           @map("approved_by_user_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  lastUsedAt       DateTime?         @map("last_used_at")
  revokedAt        DateTime?         @map("revoked_at")
  expiresAt        DateTime?         @map("expires_at")

  user      User?      @relation(fields: [userId], references: [id])
  executors Executor[]

  @@map("executor_tokens")
}

enum DisconnectReason {
  clean
  timeout
  error
}

model Executor {
  id                   String            @id @default(cuid())
  userId               String?           @map("user_id")
  executorTokenId      String            @map("executor_token_id")
  host                 String
  registeredAt         DateTime          @default(now()) @map("registered_at")
  lastHeartbeatAt      DateTime?         @map("last_heartbeat_at")
  lastDisconnectReason DisconnectReason? @map("last_disconnect_reason")

  user             User?             @relation(fields: [userId], references: [id])
  executorToken    ExecutorToken     @relation(fields: [executorTokenId], references: [id])
  pathShares       PathShare[]
  relayFilters     RelayPathFilter[]
  hubShares        HubShare[]

  // Partial unique indexes defined in raw migration SQL (Prisma does not support WHERE on @@unique):
  //   executors_user_id_host_key:           UNIQUE (user_id, host) WHERE user_id IS NOT NULL
  //   executors_executor_token_id_host_key: UNIQUE (executor_token_id, host)
  //   executors_hub_host_key:               UNIQUE (host) WHERE user_id IS NULL
  @@map("executors")
}

model PathShare {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  executorId   String  @map("executor_id")
  share        String
  reportedPath String  @map("reported_path")
  instructions String? @map("instructions")

  user     User     @relation(fields: [userId], references: [id])
  executor Executor @relation(fields: [executorId], references: [id])

  @@unique([userId, share])
  @@map("path_shares")
}

enum PatternType {
  glob
  regex
}

model RelayPathFilter {
  id              String      @id @default(cuid())
  scopeUserId     String      @map("scope_user_id")
  scopeExecutorId String?     @map("scope_executor_id")
  pattern         String
  patternType     PatternType @map("pattern_type")
  createdAt       DateTime    @default(now()) @map("created_at")

  scopeUser     User      @relation(fields: [scopeUserId], references: [id])
  scopeExecutor Executor? @relation(fields: [scopeExecutorId], references: [id])

  @@index([scopeUserId])
  @@index([scopeUserId, scopeExecutorId])
  @@map("relay_path_filters")
}

enum ActivityEventType {
  tool_call
  tool_error
  rate_limited
  executor_connect
  executor_disconnect
}

model ActivityLog {
  id           Int               @id @default(autoincrement())
  // Null for events with no associated user — e.g. connect/disconnect for
  // executors that aren't bound to any single user (hub installations).
  // Readable only by admins via GET /api/admin/activity.
  userId       String?           @map("user_id")
  eventType    ActivityEventType @map("event_type")
  host         String?
  tool         String?
  share        String?
  requestId    String?           @map("request_id")
  durationMs   Int?              @map("duration_ms")
  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  createdAt    DateTime          @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model HubShare {
  id             String   @id @default(cuid())
  executorId     String   @map("executor_id")
  share          String
  reportedPath   String   @map("reported_path")
  permissionBlob Json     @map("permission_blob")
  instructions   String?  @map("instructions")
  updatedAt      DateTime @updatedAt @map("updated_at")

  executor Executor @relation(fields: [executorId], references: [id])

  @@unique([executorId, share])
  @@map("hub_shares")
}
