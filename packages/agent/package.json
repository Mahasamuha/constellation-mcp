{
  "name": "@mahasamuha/constellation-agent",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "constellation": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
