    "pino": "^9.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@constellation/shared": "workspace:*",
    "@types/diff": "^8.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^11.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
