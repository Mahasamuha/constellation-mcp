{
  "name": "@constellation/node",
  "version": "0.5.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mahasamuha/constellation-mcp.git"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "js-yaml": "^4.1.1",
    "open": "^11.0.0",
    "picomatch": "^4.0.4",
    "pino": "^10.0.0",
    "safe-regex2": "^5.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@constellation/shared": "*",
    "@types/diff": "^8.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0"
  }
}
