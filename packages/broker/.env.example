# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=constellation
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/constellation

# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of trusted reverse proxy IP addresses or CIDR ranges.
# Required — the broker will not start without this set.
# Example: 127.0.0.1 (single proxy on localhost), or 127.0.0.1,10.0.0.0/8
TRUST_PROXY=127.0.0.1

# OIDC upstream provider
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=https://your-broker.example.com/oauth/callback

# Broker public URL (used in OAuth metadata, activation links)
BROKER_URL=https://your-broker.example.com

# Token lifetimes
OAUTH_ACCESS_TOKEN_TTL_HOURS=24
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# Timeouts
RPC_TIMEOUT_MS=30000

# Heartbeat
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_MAX_MISSED=3

# Rate limits
RATE_LIMIT_TOOL_CALLS_PER_MIN=60
RATE_LIMIT_EXPENSIVE_TOOLS_PER_MIN=20
RATE_LIMIT_OAUTH_PER_15MIN=10
RATE_LIMIT_WS_RECONNECT_PER_MIN=10
