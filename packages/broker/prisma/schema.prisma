generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  oidcSub       String?   @map("oidc_sub")
  oidcIssuer    String?   @map("oidc_issuer")
  email         String
  createdAt     DateTime  @default(now()) @map("created_at")
  deactivatedAt DateTime? @map("deactivated_at")

  agents          Agent[]
  agentTokens     AgentToken[]
  pathLabels      PathLabel[]
  brokerFilters   BrokerPathFilter[]
  oauthSessions   OauthSession[]
  localUser       LocalUser?

  @@unique([oidcSub, oidcIssuer])
  @@map("users")
}

model LocalUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")
  isActive     Boolean   @default(true) @map("is_active")
  userId       String    @unique @map("user_id")

  user User @relation(fields: [userId], references: [id])

  @@map("local_users")
}

model AgentToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user   User    @relation(fields: [userId], references: [id])
  agents Agent[]

  @@map("agent_tokens")
}

enum DisconnectReason {
  clean
  timeout
  error
}

model Agent {
  id                   String            @id @default(cuid())
  userId               String            @map("user_id")
  agentTokenId         String            @map("agent_token_id")
  host                 String
  registeredAt         DateTime          @default(now()) @map("registered_at")
  lastHeartbeatAt      DateTime?         @map("last_heartbeat_at")
  lastDisconnectReason DisconnectReason? @map("last_disconnect_reason")

  user          User               @relation(fields: [userId], references: [id])
  agentToken    AgentToken         @relation(fields: [agentTokenId], references: [id])
  pathLabels    PathLabel[]
  brokerFilters BrokerPathFilter[]

  @@unique([userId, host])
  @@map("agents")
}

model PathLabel {
  id           String @id @default(cuid())
  userId       String @map("user_id")
  agentId      String @map("agent_id")
  label        String
  reportedPath String @map("reported_path")

  user  User  @relation(fields: [userId], references: [id])
  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([userId, label])
  @@map("path_labels")
}

enum PatternType {
  glob
  regex
}

model BrokerPathFilter {
  id            String      @id @default(cuid())
  scopeUserId   String      @map("scope_user_id")
  scopeAgentId  String?     @map("scope_agent_id")
  pattern       String
  patternType   PatternType @map("pattern_type")
  createdAt     DateTime    @default(now()) @map("created_at")

  scopeUser  User   @relation(fields: [scopeUserId], references: [id])
  scopeAgent Agent? @relation(fields: [scopeAgentId], references: [id])

  @@map("broker_path_filters")
}

model AuthCode {
  codeHash            String   @id @map("code_hash")
  userId              String   @map("user_id")
  clientId            String   @map("client_id")
  redirectUri         String   @map("redirect_uri")
  codeChallenge       String?  @map("code_challenge")
  codeChallengeMethod String?  @map("code_challenge_method")
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("auth_codes")
}

model DeviceCode {
  deviceCode    String   @id @map("device_code")
  userCode      String   @unique @map("user_code")
  scope         String
  expiresAt     DateTime @map("expires_at")
  status        String   @default("pending")
  userId        String?  @map("user_id")
  hostName      String?  @map("host_name")
  pendingUserId String?  @map("pending_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("device_codes")
}

model OauthClient {
  id               String   @id @default(cuid())
  clientSecretHash String?  @map("client_secret_hash")
  redirectUris     String[] @map("redirect_uris")
  grantTypes       String[] @map("grant_types")
  isDynamic        Boolean  @map("is_dynamic")
  createdAt        DateTime @default(now()) @map("created_at")

  oauthSessions OauthSession[]

  @@map("oauth_clients")
}

model OauthSession {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  mcpClientId           String    @map("mcp_client_id")
  accessTokenHash       String    @unique @map("access_token_hash")
  issuedAt              DateTime  @default(now()) @map("issued_at")
  expiresAt             DateTime  @map("expires_at")
  refreshTokenHash      String?   @unique @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")

  user      User        @relation(fields: [userId], references: [id])
  mcpClient OauthClient @relation(fields: [mcpClientId], references: [id])

  @@map("oauth_sessions")
}
